                  <td className="px-3 py-2" style={{ color: MUTED }}>{r.date}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <p className="text-xs mt-3" style={{ color: MUTED }}>
          Nota: este login é uma proteção simples para fins de demonstração. Para uso em produção, recomenda-se autenticação real no servidor.
        </p>
      </div>
    </main>
  );
}

