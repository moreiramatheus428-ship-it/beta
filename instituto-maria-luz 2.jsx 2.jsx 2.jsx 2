function QuizPage({ course, lessonIndex, setView, studentName, studentCode, data, saveResult }) {
  const lesson = course.lessons[lessonIndex];
  const [answers, setAnswers] = useState(Array(lesson.quiz.length).fill(null));
  const [submitted, setSubmitted] = useState(false);
  const key = slug(studentName, studentCode);

  const score = lesson.quiz.reduce((acc, q, i) => acc + (answers[i] === q.correct ? 1 : 0), 0);
  const allAnswered = answers.every((a) => a !== null);

  function handleSubmit() {
    if (!allAnswered) return;
    setSubmitted(true);
    saveResult(course.id, lessonIndex, score, lesson.quiz.length);
  }

  return (
    <main className="px-5 py-10">
      <div className="max-w-2xl mx-auto">
        <button onClick={() => setView({ screen: "lesson", courseId: course.id, lessonIndex })} className="text-sm flex items-center gap-1 mb-6" style={{ color: MUTED }}>
          <ArrowLeft size={14} /> Voltar à aula
        </button>
        <div className="text-xs font-medium mb-1" style={{ color: course.color }}>Prova · {lesson.title}</div>
        <h1 className="font-bold text-2xl mb-2" style={{ color: INK }}>Prova desta aula</h1>
        <p className="text-sm mb-6" style={{ color: MUTED }}>
          Sem tempo limite — responda com calma. Você só avança para a próxima aula depois de enviar.
        </p>

        <div className="flex flex-col gap-4">
          {lesson.quiz.map((q, qi) => (
            <div key={qi} className="bg-white rounded-lg p-4" style={{ border: `1px solid ${LINE}` }}>
              <div className="font-medium text-sm mb-3" style={{ color: INK }}>{qi + 1}. {q.q}</div>
              <div className="flex flex-col gap-2">
                {q.options.map((opt, oi) => {
                  const chosen = answers[qi] === oi;
                  let bg = "#fff", border = LINE, txt = INK;
                  if (submitted) {
                    if (oi === q.correct) { bg = "#E9F6EF"; border = "#3B8C6E"; }
                    else if (chosen) { bg = "#FBE9E7"; border = "#C0392B"; }
                  } else if (chosen) {
                    bg = course.soft; border = course.color;
                  }
                  return (
                    <button
                      key={oi}
                      disabled={submitted}
                      onClick={() => {
                        const next = [...answers];
                        next[qi] = oi;
                        setAnswers(next);
                      }}
                      className="text-left text-sm px-3 py-2 rounded-md"
                      style={{ background: bg, border: `1px solid ${border}`, color: txt }}
                    >
                      {opt}
                    </button>
                  );
                })}
              </div>
            </div>
          ))}
        </div>

        {!submitted ? (
          <button
            onClick={handleSubmit}
            disabled={!allAnswered}
            className="mt-6 w-full text-sm font-semibold px-4 py-3 rounded-md text-white"
            style={{ background: allAnswered ? course.color : "#B9B6AA" }}
          >
            Enviar respostas
          </button>
        ) : (
          <div className="mt-6 bg-white rounded-lg p-5 text-center" style={{ border: `1px solid ${LINE}` }}>
            <div className="font-bold text-lg mb-1" style={{ color: score / lesson.quiz.length >= PASS_THRESHOLD ? "#3B8C6E" : "#C0392B" }}>
              Você acertou {score} de {lesson.quiz.length}
            </div>
            <div className="text-sm mb-4" style={{ color: MUTED }}>
              {score / lesson.quiz.length >= PASS_THRESHOLD
                ? "Bom trabalho! Você pode seguir para a próxima aula."
                : "Considere revisar o conteúdo e refazer a prova antes de seguir."}
            </div>
            <button
              onClick={() => setView({ screen: "lesson", courseId: course.id, lessonIndex })}
              className="text-sm font-semibold px-4 py-2 rounded-md text-white"
              style={{ background: course.color }}
            >
              Voltar à aula
            </button>
          </div>
        )}
      </div>
    </main>
  );
}

