/* ---------------------------------------------------------------
   Utilidades
----------------------------------------------------------------*/
function slug(name, code) {
  return (name.trim() + (code ? "-" + code.trim() : "")).toLowerCase().replace(/\s+/g, "-");
}

function emptyData() {
  return { students: {} };
}

function getLessonResult(data, studentKey, courseId, lessonIndex) {
  return data?.students?.[studentKey]?.progress?.[courseId]?.[lessonIndex] || null;
}

function isLessonUnlocked(data, studentKey, courseId, lessonIndex) {
  if (lessonIndex === 0) return true;
  const prev = getLessonResult(data, studentKey, courseId, lessonIndex - 1);
  return !!prev?.done;
}

/* ---------------------------------------------------------------
   Elemento decorativo inspirado na identidade do instituto
----------------------------------------------------------------*/
function HandStripe({ size = "normal" }) {
  const h = size === "small" ? 6 : 10;
  return (
    <div className="flex items-end gap-1.5" style={{ height: h + 6 }}>
      {HAND_COLORS.map((c, i) => (
        <div
          key={i}
          style={{
            background: c,
            width: h,
            height: h + (i % 2 === 0 ? 10 : 0),
            borderRadius: 999,
          }}
        />
      ))}
    </div>
  );
}

