function AdminDashboard({ data, setView, setAdminAuthed }) {
  const [filterCourse, setFilterCourse] = useState("todos");

  const rows = [];
  Object.entries(data.students || {}).forEach(([sKey, s]) => {
    COURSES.forEach((course) => {
      course.lessons.forEach((lesson, i) => {
        const r = s.progress?.[course.id]?.[i];
        if (r?.done) {
          rows.push({
            student: s.name,
            code: s.code,
            courseId: course.id,
            courseName: course.name,
            lessonName: lesson.title,
            score: r.score,
            total: r.total,
            pct: Math.round((r.score / r.total) * 100),
            date: r.date,
          });
        }
      });
    });
  });

  const filteredRows = filterCourse === "todos" ? rows : rows.filter((r) => r.courseId === filterCourse);
  const totalStudents = Object.keys(data.students || {}).length;
  const avgPct = filteredRows.length ? Math.round(filteredRows.reduce((a, r) => a + r.pct, 0) / filteredRows.length) : 0;

  return (
    <main className="px-5 py-10">
      <div className="max-w-5xl mx-auto">
        <div className="flex items-center justify-between mb-6">
          <div className="flex items-center gap-2" style={{ color: NAVY }}>
            <ShieldCheck size={20} />
            <div className="font-bold text-xl">Resultados dos alunos</div>
          </div>
          <button
            onClick={() => { setAdminAuthed(false); setView({ screen: "home" }); }}
            className="text-sm font-medium flex items-center gap-1.5"
            style={{ color: MUTED }}
          >
            <LogOut size={15} /> Sair
          </button>
        </div>

        <div className="grid grid-cols-1 sm:grid-cols-3 gap-4 mb-8">
          <div className="bg-white rounded-lg p-4 flex items-center gap-3" style={{ border: `1px solid ${LINE}` }}>
            <Users size={20} color={NAVY} />
            <div>
              <div className="font-bold text-lg" style={{ color: INK }}>{totalStudents}</div>
              <div className="text-xs" style={{ color: MUTED }}>Alunos cadastrados</div>
            </div>
          </div>
          <div className="bg-white rounded-lg p-4 flex items-center gap-3" style={{ border: `1px solid ${LINE}` }}>
            <ClipboardList size={20} color={NAVY} />
            <div>
              <div className="font-bold text-lg" style={{ color: INK }}>{filteredRows.length}</div>
              <div className="text-xs" style={{ color: MUTED }}>Provas concluídas</div>
            </div>
          </div>
          <div className="bg-white rounded-lg p-4 flex items-center gap-3" style={{ border: `1px solid ${LINE}` }}>
            <Award size={20} color={NAVY} />
            <div>
              <div className="font-bold text-lg" style={{ color: INK }}>{avgPct}%</div>
              <div className="text-xs" style={{ color: MUTED }}>Média de acertos</div>
            </div>
          </div>
        </div>

        <div className="flex items-center gap-2 mb-3">
          <BarChart3 size={16} color={MUTED} />
          <select
            value={filterCourse}
            onChange={(e) => setFilterCourse(e.target.value)}
            className="text-sm px-2 py-1.5 rounded-md"
            style={{ border: `1px solid ${LINE}` }}
          >
            <option value="todos">Todas as matérias</option>
            {COURSES.map((c) => <option key={c.id} value={c.id}>{c.name}</option>)}
          </select>
        </div>

        <div className="bg-white rounded-lg overflow-hidden" style={{ border: `1px solid ${LINE}` }}>
          <table className="w-full text-sm">
            <thead>
              <tr style={{ background: PAPER }}>
                {["Aluno", "Turma/código", "Matéria", "Aula", "Nota", "%", "Data"].map((h) => (
                  <th key={h} className="text-left px-3 py-2 font-semibold" style={{ color: INK, borderBottom: `1px solid ${LINE}` }}>{h}</th>
                ))}
              </tr>
            </thead>
            <tbody>
              {filteredRows.length === 0 ? (
                <tr><td colSpan={7} className="px-3 py-6 text-center" style={{ color: MUTED }}>Nenhum resultado registrado ainda.</td></tr>
              ) : filteredRows.map((r, i) => (
                <tr key={i} style={{ borderBottom: `1px solid ${LINE}` }}>
                  <td className="px-3 py-2" style={{ color: INK }}>{r.student}</td>
                  <td className="px-3 py-2" style={{ color: MUTED }}>{r.code || "—"}</td>
                  <td className="px-3 py-2" style={{ color: MUTED }}>{r.courseName}</td>
