  const [studentName, setStudentNameState] = useState("");
  const [studentCode, setStudentCodeState] = useState("");
  const [data, setData] = useState(emptyData());
  const [adminAuthed, setAdminAuthed] = useState(false);
  const [loaded, setLoaded] = useState(false);

  useEffect(() => {
    (async () => {
      try {
        const res = await window.storage.get(STORAGE_KEY, true);
        if (res?.value) setData(JSON.parse(res.value));
      } catch (e) { /* nenhum dado salvo ainda */ }
      try {
        const last = await window.storage.get("iml_ultimo_aluno", false);
        if (last?.value) {
          const parsed = JSON.parse(last.value);
          setStudentNameState(parsed.name || "");
          setStudentCodeState(parsed.code || "");
        }
      } catch (e) { /* nenhum aluno salvo ainda */ }
      setLoaded(true);
    })();
  }, []);

  function setStudentName(name) {
    setStudentNameState(name);
    if (name) {
      window.storage.set("iml_ultimo_aluno", JSON.stringify({ name, code: studentCode }), false).catch(() => {});
      const key = slug(name, studentCode);
      setData((prev) => {
        const next = { ...prev, students: { ...prev.students } };
        if (!next.students[key]) next.students[key] = { name, code: studentCode, progress: {} };
        window.storage.set(STORAGE_KEY, JSON.stringify(next), true).catch(() => {});
        return next;
      });
    }
  }

  function setStudentCode(code) {
    setStudentCodeState(code);
  }

  function saveResult(courseId, lessonIndex, score, total) {
    const key = slug(studentName, studentCode);
    setData((prev) => {
      const next = { ...prev, students: { ...prev.students } };
      const student = next.students[key] || { name: studentName, code: studentCode, progress: {} };
      const progress = { ...student.progress, [courseId]: { ...(student.progress?.[courseId] || {}) } };
      progress[courseId][lessonIndex] = {
        done: true,
        score,
        total,
        passed: score / total >= PASS_THRESHOLD,
        date: new Date().toLocaleDateString("pt-BR"),
      };
      next.students[key] = { ...student, progress };
      window.storage.set(STORAGE_KEY, JSON.stringify(next), true).catch(() => {});
      return next;
    });
  }

  if (!loaded) {
    return <div className="min-h-screen flex items-center justify-center" style={{ background: PAPER, color: MUTED }}>Carregando…</div>;
  }

  let content;
  if (view.screen === "home") {
    content = <Home setView={setView} studentName={studentName} setStudentName={setStudentName} studentCode={studentCode} setStudentCode={setStudentCode} data={data} />;
  } else if (view.screen === "course") {
    const course = COURSES.find((c) => c.id === view.courseId);
    content = <CoursePage course={course} setView={setView} studentName={studentName} studentCode={studentCode} data={data} />;
  } else if (view.screen === "lesson") {
    const course = COURSES.find((c) => c.id === view.courseId);
    content = <LessonPage course={course} lessonIndex={view.lessonIndex} setView={setView} studentName={studentName} studentCode={studentCode} data={data} />;
  } else if (view.screen === "quiz") {
    const course = COURSES.find((c) => c.id === view.courseId);
    content = <QuizPage course={course} lessonIndex={view.lessonIndex} setView={setView} studentName={studentName} studentCode={studentCode} data={data} saveResult={saveResult} />;
  } else if (view.screen === "admin-login") {
    content = <AdminLogin setView={setView} setAdminAuthed={setAdminAuthed} />;
  } else if (view.screen === "admin-dashboard") {
    content = adminAuthed
      ? <AdminDashboard data={data} setView={setView} setAdminAuthed={setAdminAuthed} />
      : <AdminLogin setView={setView} setAdminAuthed={setAdminAuthed} />;
  }

  return (
    <div className="min-h-screen" style={{ background: PAPER, fontFamily: "system-ui, -apple-system, sans-serif" }}>
      <Header view={view} setView={setView} studentName={studentName} />
      {content}
    </div>
  );
}
