function LessonPage({ course, lessonIndex, setView, studentName, studentCode, data }) {
  const lesson = course.lessons[lessonIndex];
  const key = studentName ? slug(studentName, studentCode) : null;
  const result = key ? getLessonResult(data, key, course.id, lessonIndex) : null;
  const [speaking, setSpeaking] = useState(false);
  const supportsSpeech = typeof window !== "undefined" && "speechSynthesis" in window;

  useEffect(() => () => { if (supportsSpeech) window.speechSynthesis.cancel(); }, []);

  function playAudio() {
    if (!supportsSpeech) return;
    window.speechSynthesis.cancel();
    const utterances = [];
    const introU = new SpeechSynthesisUtterance(lesson.intro);
    introU.lang = "pt-BR";
    utterances.push(introU);
    lesson.vocab.forEach((v) => {
      if (course.speechLang) {
        const t = new SpeechSynthesisUtterance(v.term);
        t.lang = course.speechLang;
        utterances.push(t);
        const tr = new SpeechSynthesisUtterance(v.translation);
        tr.lang = "pt-BR";
        utterances.push(tr);
      } else {
        const u = new SpeechSynthesisUtterance(`${v.term}. ${v.translation}`);
        u.lang = "pt-BR";
        utterances.push(u);
      }
    });
    utterances[utterances.length - 1].onend = () => setSpeaking(false);
    setSpeaking(true);
    utterances.forEach((u) => window.speechSynthesis.speak(u));
  }

  function stopAudio() {
    if (supportsSpeech) window.speechSynthesis.cancel();
    setSpeaking(false);
  }

  return (
    <main className="px-5 py-10">
      <div className="max-w-2xl mx-auto">
        <button onClick={() => setView({ screen: "course", courseId: course.id })} className="text-sm flex items-center gap-1 mb-6" style={{ color: MUTED }}>
          <ArrowLeft size={14} /> {course.name}
        </button>

        <div className="text-xs font-medium mb-1" style={{ color: course.color }}>
          Aula {lessonIndex + 1} de {course.lessons.length}
        </div>
        <h1 className="font-bold text-2xl mb-4" style={{ color: INK }}>{lesson.title}</h1>

        <div className="bg-white rounded-lg p-5 mb-5" style={{ border: `1px solid ${LINE}` }}>
          <p className="text-sm mb-4" style={{ color: INK, lineHeight: 1.6 }}>{lesson.intro}</p>

          {supportsSpeech && (
            <button
              onClick={speaking ? stopAudio : playAudio}
              className="flex items-center gap-2 text-sm font-medium px-3 py-1.5 rounded-md mb-5"
              style={{ background: course.soft, color: course.color }}
            >
              {speaking ? <VolumeX size={16} /> : <Volume2 size={16} />}
              {speaking ? "Parar áudio" : "Ouvir esta aula"}
            </button>
          )}

          <div className="text-xs font-semibold uppercase tracking-wide mb-2" style={{ color: MUTED, textTransform: "none" }}>
            Conteúdo desta aula
          </div>
          <div className="grid grid-cols-1 gap-2">
            {lesson.vocab.map((v, i) => (
              <div key={i} className="flex items-center justify-between px-3 py-2 rounded-md" style={{ background: PAPER }}>
                <span className="font-medium text-sm" style={{ color: INK }}>{v.term}</span>
                <span className="text-xs text-right ml-3" style={{ color: MUTED, maxWidth: "60%" }}>{v.translation}</span>
              </div>
            ))}
          </div>
        </div>

        {result?.done ? (
          <div className="bg-white rounded-lg p-5" style={{ border: `1px solid ${LINE}` }}>
            <div className="flex items-center gap-2 font-semibold mb-1" style={{ color: "#3B8C6E" }}>
              <CheckCircle2 size={18} /> Prova concluída
            </div>
            <div className="text-sm mb-4" style={{ color: MUTED }}>
              Você acertou {result.score} de {result.total} questões ({Math.round((result.score / result.total) * 100)}%).
            </div>
            <div className="flex flex-wrap gap-3">
              <button onClick={() => setView({ screen: "quiz", courseId: course.id, lessonIndex })} className="text-sm font-medium px-4 py-2 rounded-md" style={{ border: `1px solid ${LINE}`, color: INK }}>
                Refazer prova
              </button>
              {lessonIndex < course.lessons.length - 1 ? (
                <button
                  onClick={() => setView({ screen: "lesson", courseId: course.id, lessonIndex: lessonIndex + 1 })}
                  className="text-sm font-semibold px-4 py-2 rounded-md text-white flex items-center gap-1.5"
                  style={{ background: course.color }}
                >
                  Próxima aula <ChevronRight size={15} />
                </button>
              ) : (
                <button onClick={() => setView({ screen: "course", courseId: course.id })} className="text-sm font-semibold px-4 py-2 rounded-md text-white" style={{ background: course.color }}>
                  Ver programa completo
                </button>
              )}
            </div>
          </div>
        ) : (
          <button
            onClick={() => setView({ screen: "quiz", courseId: course.id, lessonIndex })}
            disabled={!studentName}
            className="w-full flex items-center justify-center gap-2 text-sm font-semibold px-4 py-3 rounded-md text-white"
            style={{ background: studentName ? course.color : "#B9B6AA" }}
